<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>SSH Manager</AssemblyTitle>
    <!-- regenerate with IconFactory.WriteIco after changing the drawing -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Fluent ThemeMode is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep WPF types unambiguous -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SshManager.Core\SshManager.Core.csproj" />
    <ProjectReference Include="..\sshm\sshm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SshManager.Core.Localization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- built-in terminal page (xterm.js), served to WebView2 from the app folder -->
    <Content Include="Assets\terminal\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- built-in editor page (CodeMirror 6, bundle built from tools\codemirror) -->
    <Content Include="Assets\editor\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
