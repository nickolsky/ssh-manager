<Window x:Class="SshManager.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SshManager.Localization"
        Title="{l:Tr ChangePwd.Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,16,24,20">
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr ChangePwd.Current}" />
        <PasswordBox x:Name="Current" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr ChangePwd.New}" />
        <PasswordBox x:Name="New" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr ChangePwd.Repeat}" />
        <PasswordBox x:Name="Confirm" />
        <TextBlock x:Name="Error" Foreground="#E0443E" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="Hidden" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="{l:Tr ChangePwd.Change}" IsDefault="True" Click="OnOk"
                    Style="{DynamicResource AccentButtonStyle}" MinWidth="100" />
            <Button Content="{l:Tr Common.Cancel}" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
