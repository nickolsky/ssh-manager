<Window x:Class="SshManager.Views.AgentLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SshManager.Localization"
        xmlns:c="clr-namespace:SshManager.Views.Controls"
        Title="{l:Tr AgentLog.Title}" Width="1100" Height="620" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16,12,16,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{l:Tr AgentLog.Server}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="ServerBox" MinWidth="260" SelectionChanged="OnServerChanged" />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <RadioButton x:Name="ConsoleMode" GroupName="view" Style="{StaticResource {x:Type ToggleButton}}" Content="{l:Tr AgentLog.Console}"
                             ToolTip="{l:Tr AgentLog.ConsoleTip}" MinWidth="90" IsChecked="True" Checked="OnViewChanged" />
                <RadioButton x:Name="LinesMode" GroupName="view" Style="{StaticResource {x:Type ToggleButton}}" Content="{l:Tr AgentLog.Lines}"
                             ToolTip="{l:Tr AgentLog.LinesTip}" MinWidth="90" Margin="4,0,0,0" Checked="OnViewChanged" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="PauseButton" Content="{l:Tr AgentLog.Pause}" Margin="0,0,8,0" MinWidth="90" />
                <Button Content="{l:Tr AgentLog.OpenFolder}" Click="OnOpenFolder" MinWidth="90" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="Status" Style="{StaticResource Hint}" Margin="0,8,0,0" />
        <Grid>
            <Border x:Name="ConsoleHost" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                <c:LogConsoleView x:Name="LogConsole" />
            </Border>
            <TextBox x:Name="Lines" Visibility="Collapsed" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
