<Window x:Class="SshManager.Views.ScriptRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SshManager.Localization"
        Title="{l:Tr ScriptRun.Title}" Width="860" Height="720" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- one row per script parameter; the editor depends on Kind -->
        <DataTemplate x:Key="ParamRow">
            <Grid Margin="0,0,0,10">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" ToolTip="{Binding Name}" />
                <TextBox x:Name="TextEditor" Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox x:Name="ChoiceEditor" Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"
                          Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="200" />
                <CheckBox x:Name="BoolEditor" Grid.Column="1" IsChecked="{Binding Checked}" Visibility="Collapsed" VerticalAlignment="Center" />
                <PasswordBox x:Name="SecretEditor" Grid.Column="1" Visibility="Collapsed" Tag="{Binding}" PasswordChanged="OnSecretChanged" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hint}" Margin="0,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Choice">
                    <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ChoiceEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bool">
                    <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BoolEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Secret">
                    <Setter TargetName="TextEditor" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SecretEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Number">
                    <Setter TargetName="TextEditor" Property="HorizontalAlignment" Value="Left" />
                    <Setter TargetName="TextEditor" Property="MinWidth" Value="120" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="Description" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="OsWarning" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        </StackPanel>

        <!-- parameters -->
        <ScrollViewer Grid.Row="1" x:Name="ParamsBox" VerticalScrollBarVisibility="Auto" MaxHeight="280" Margin="0,14,0,0">
            <ItemsControl x:Name="ParamsList" ItemTemplate="{StaticResource ParamRow}" Margin="0,0,8,0" />
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,6">
            <TextBlock Text="{l:Tr ScriptRun.Output}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="120" Height="4" Margin="12,0,0,0" Visibility="Hidden" HorizontalAlignment="Left" />
        </DockPanel>
        <TextBox Grid.Row="3" x:Name="Output" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" AcceptsReturn="True" />

        <!-- results reported by the script -->
        <Border Grid.Row="4" x:Name="ResultsBox" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="ResultsHeader" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <Button Grid.Column="2" Content="{l:Tr Qr.Show}" Margin="6,0,0,0" Tag="{Binding}" Click="OnShowQr" Visibility="{Binding QrVisibility}" />
                                <Button Grid.Column="3" Content="{l:Tr ScriptRun.Copy}" Margin="6,0,0,0" Tag="{Binding Value}" Click="OnCopyResult" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" x:Name="TerminalButton" Content="{l:Tr ScriptRun.InTerminal}" Click="OnRunInTerminal"
                    ToolTip="{l:Tr ScriptRun.InTerminalTip}" Padding="12,5" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RunButton" Content="{l:Tr ScriptRun.Run}" IsDefault="True" Click="OnRun" Style="{DynamicResource AccentButtonStyle}" MinWidth="120" />
                <Button x:Name="StopButton" Content="{l:Tr ScriptRun.Stop}" Click="OnStop" Style="{StaticResource DialogButton}" Visibility="Collapsed" />
                <Button x:Name="CloseButton" Content="{l:Tr Common.Close}" IsCancel="True" Click="OnClose" Style="{StaticResource DialogButton}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
