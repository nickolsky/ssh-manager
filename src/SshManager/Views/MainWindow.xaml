<Window x:Class="SshManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SshManager.ViewModels"
        Title="SSH Manager" Width="1000" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddServerCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}" />
    </Window.InputBindings>

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">
            <!-- ================= SERVERS ================= -->
            <TabItem Header="Серверы">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBox DockPanel.Dock="Right" Width="240" x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по названию, адресу, группе, заметкам (Ctrl+F)" />
                        <TextBlock DockPanel.Dock="Right" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                        <WrapPanel>
                            <Button Content="▶  Подключиться" Command="{Binding ConnectCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0" Padding="14,5" />
                            <Button Content="+ Сервер" Command="{Binding AddServerCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Ctrl+N" />
                            <Button Content="Изменить" Command="{Binding EditServerCommand}" Style="{StaticResource ToolbarButton}" />
                            <Button Content="🔑 Настроить вход по ключу" Command="{Binding SetupKeyCommand}" Style="{StaticResource ToolbarButton}"
                                    ToolTip="Войти по паролю, установить ключ в authorized_keys и переключить сервер на ключ" />
                            <Button Content="Проверить" Command="{Binding TestCommand}" Style="{StaticResource ToolbarButton}" />
                        </WrapPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="ServersGrid" ItemsSource="{Binding ServersView}"
                              SelectedItem="{Binding SelectedServer}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              MouseDoubleClick="OnServerDoubleClick" PreviewKeyDown="OnServersKeyDown">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,10,0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Opacity="0.6" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <!-- Pixel widths: star widths collapse on first show in a grouped DataGrid.
                                 The last column fills the rest; user-resized widths are saved in settings. -->
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="220" MinWidth="80" />
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="220" MinWidth="80" />
                            <DataGridTextColumn Header="Вход" Binding="{Binding AuthText}" Width="170" MinWidth="70" />
                            <DataGridTextColumn Header="Последнее подключение" Binding="{Binding LastConnected}" Width="170" MinWidth="80" />
                            <DataGridTextColumn Header="Заметки" Binding="{Binding Notes}" Width="*" MinWidth="120" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Подключиться" Command="{Binding ConnectCommand}" FontWeight="SemiBold" />
                                <Separator />
                                <MenuItem Header="Изменить…" Command="{Binding EditServerCommand}" />
                                <MenuItem Header="Дублировать…" Command="{Binding DuplicateServerCommand}" />
                                <MenuItem Header="Копировать команду ssh" Command="{Binding CopyCommandCommand}" />
                                <Separator />
                                <MenuItem Header="Настроить вход по ключу…" Command="{Binding SetupKeyCommand}" />
                                <MenuItem Header="Проверить подключение" Command="{Binding TestCommand}" />
                                <Separator />
                                <MenuItem Header="Удалить" Command="{Binding DeleteServerCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= KEYS ================= -->
            <TabItem Header="Ключи">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="+ Сгенерировать" Command="{Binding GenerateKeyCommand}"
                                Style="{DynamicResource AccentButtonStyle}" Margin="0,0,6,0" Padding="14,5" />
                        <Button Content="Импорт…" Command="{Binding ImportKeyCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Копировать публичный ключ" Command="{Binding CopyPublicKeyCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Экспорт приватного…" Command="{Binding ExportPrivateKeyCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Переименовать" Command="{Binding RenameKeyCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Удалить" Command="{Binding DeleteKeyCommand}" Style="{StaticResource ToolbarButton}" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="KeysGrid" ItemsSource="{Binding Keys}" SelectedItem="{Binding SelectedKey}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="190" MinWidth="80" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80" MinWidth="60" />
                            <DataGridTextColumn Header="Отпечаток" Binding="{Binding Fingerprint}" Width="330" MinWidth="120" />
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="170" MinWidth="80" />
                            <DataGridTextColumn Header="Создан" Binding="{Binding Created}" Width="95" MinWidth="70" />
                            <DataGridTextColumn Header="Серверы" Binding="{Binding UsedBy}" Width="*" MinWidth="120" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать публичный ключ" Command="{Binding CopyPublicKeyCommand}" />
                                <MenuItem Header="Экспорт приватного…" Command="{Binding ExportPrivateKeyCommand}" />
                                <MenuItem Header="Переименовать…" Command="{Binding RenameKeyCommand}" />
                                <Separator />
                                <MenuItem Header="Удалить" Command="{Binding DeleteKeyCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= SETTINGS ================= -->
            <TabItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,4,16,16" MaxWidth="720" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Запуск и трей" />
                        <CheckBox Content="Запускать вместе с Windows (сразу в трей, заблокированным)" IsChecked="{Binding Autostart}" />
                        <CheckBox Content="Кнопка закрытия сворачивает в трей (агент продолжает работать)" IsChecked="{Binding CloseToTray}" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Безопасность" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Автоблокировка после простоя ПК, минут (0 — никогда):" VerticalAlignment="Center" />
                            <TextBox Width="70" Margin="10,0,0,0" Text="{Binding AutoLockMinutes, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <CheckBox Content="Блокировать при блокировке Windows (Win+L)" IsChecked="{Binding LockOnWindowsLock}" Margin="0,8,0,0" />
                        <CheckBox Content="Показывать окно разблокировки, когда ssh / git / VS Code обращаются к агенту"
                                  IsChecked="{Binding UnlockOnAgentRequest}" Margin="0,8,0,0" />
                        <Button Content="Сменить мастер-пароль…" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding DataContext.ChangePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Терминал" />
                        <ComboBox SelectedIndex="{Binding TerminalIndex}" Width="360" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Windows Terminal — новая вкладка" />
                            <ComboBoxItem Content="Windows Terminal — новое окно" />
                            <ComboBoxItem Content="Обычное окно консоли" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding TerminalInfo}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Профиль Windows Terminal (необязательно)" />
                        <TextBox Width="360" HorizontalAlignment="Left" Text="{Binding WindowsTerminalProfile, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Путь к ssh.exe (пусто — системный OpenSSH)" />
                        <TextBox Text="{Binding SshPath, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding EffectiveSshPath}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="ServerAliveInterval, секунд (0 — выкл.):" VerticalAlignment="Center" />
                            <TextBox Width="70" Margin="10,0,0,0" Text="{Binding ServerAliveInterval, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding HelperInfo}" Margin="0,10,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Данные" />
                        <TextBlock Text="{Binding DataDir}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="vault.dat — зашифрованное хранилище, backups — его предыдущие версии, known_hosts — ключи серверов, pub — публичные ключи. Для резервной копии скопируйте всю папку data и помните мастер-пароль." />
                        <Button Content="Открыть папку данных" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding DataContext.OpenDataFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- status bar -->
        <DockPanel Grid.Row="1" Margin="2,8,0,0">
            <Button DockPanel.Dock="Right" Content="🔒 Заблокировать" Command="{Binding LockCommand}" Padding="10,3" ToolTip="Ctrl+L" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.7" />
            <StackPanel>
                <TextBlock Text="{Binding AgentStatus}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
