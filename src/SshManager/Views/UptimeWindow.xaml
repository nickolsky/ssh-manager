<Window x:Class="SshManager.Views.UptimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SshManager.Views.Controls"
        xmlns:l="clr-namespace:SshManager.Localization"
        Title="{l:Tr Uptime.Title}" Width="900" Height="700" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <ComboBox x:Name="Period" DockPanel.Dock="Right" Width="170" SelectionChanged="OnPeriodChanged">
                <ComboBoxItem Content="{l:Tr Uptime.Period24h}" />
                <ComboBoxItem Content="{l:Tr Uptime.Period7d}" />
                <ComboBoxItem Content="{l:Tr Uptime.Period30d}" />
                <ComboBoxItem Content="{l:Tr Uptime.Period90d}" />
                <ComboBoxItem Content="{l:Tr Uptime.Period365d}" />
            </ComboBox>
            <TextBlock x:Name="Header" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <!-- summary tiles -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,14,0,0" x:Name="Tiles">
            <UniformGrid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,0,10,0" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                </Style>
            </UniformGrid.Resources>
            <Border>
                <StackPanel>
                    <TextBlock Text="{l:Tr Uptime.TileUptime}" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="UptimeValue" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="{l:Tr Uptime.TileOutages}" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="OutagesValue" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border>
                <StackPanel>
                    <TextBlock Text="{l:Tr Uptime.TileDowntime}" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="DowntimeValue" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="0">
                <StackPanel>
                    <TextBlock Text="{l:Tr Uptime.TileLatency}" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="LatencyValue" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <DockPanel Grid.Row="2" Margin="0,16,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Uptime.LegendUp}" Style="{StaticResource Hint}" Margin="5,0,14,0" VerticalAlignment="Center" />
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Uptime.LegendDegraded}" Style="{StaticResource Hint}" Margin="5,0,14,0" VerticalAlignment="Center" />
                <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Uptime.LegendDown}" Style="{StaticResource Hint}" Margin="5,0,14,0" VerticalAlignment="Center" />
                <Rectangle Width="10" Height="3" Fill="{DynamicResource ControlStrongFillColorDisabledBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{l:Tr Uptime.LegendNoData}" Style="{StaticResource Hint}" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{l:Tr Uptime.Availability}" FontWeight="SemiBold" />
        </DockPanel>
        <c:UptimeChart Grid.Row="3" x:Name="AvailabilityChart" />

        <TextBlock Grid.Row="4" Text="{l:Tr Uptime.Latency}" FontWeight="SemiBold" Margin="0,14,0,6" />
        <c:UptimeChart Grid.Row="5" x:Name="LatencyChart" ShowLatency="True" />

        <TextBlock Grid.Row="6" x:Name="OutagesHeader" FontWeight="SemiBold" Margin="0,14,0,6" />
        <DataGrid Grid.Row="7" x:Name="OutagesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Tr Uptime.OutageFrom}" Binding="{Binding From}" Width="170" />
                <DataGridTextColumn Header="{l:Tr Uptime.OutageTo}" Binding="{Binding To}" Width="170" />
                <DataGridTextColumn Header="{l:Tr Uptime.OutageDuration}" Binding="{Binding Duration}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="8" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Tr Common.Close}" IsCancel="True" Click="OnClose" MinWidth="110" />
            <TextBlock x:Name="Footer" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
